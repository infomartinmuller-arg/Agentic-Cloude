{
  "name": "03 - Token Refresh (Scheduled)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 45 }]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 45 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "list", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "list", "value": "Users" },
        "options": {}
      },
      "id": "read-all-users",
      "name": "Read All Users",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "// ==========================================================\n// Filter users whose tokens expire within 10 minutes\n// ==========================================================\nconst items = $input.all();\nconst now = new Date();\nconst tenMinutesFromNow = new Date(now.getTime() + 10 * 60 * 1000);\n\nconst usersToRefresh = items.filter(item => {\n  const userData = item.json;\n  if (userData.state !== 'active' || !userData.refresh_token) return false;\n  \n  const tokenExpiry = new Date(userData.token_expiry);\n  // Refresh if token expires within 10 minutes or is already expired\n  return tokenExpiry <= tenMinutesFromNow;\n});\n\nif (usersToRefresh.length === 0) {\n  return [{ json: { skip: true, message: 'No tokens need refreshing' } }];\n}\n\nreturn usersToRefresh.map(item => ({ json: item.json }));"
      },
      "id": "filter-expiring",
      "name": "Filter Expiring Tokens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "skip-check",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals", "singleValue": true }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "any-to-refresh",
      "name": "Any to Refresh?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/x-www-form-urlencoded" }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "client_id", "value": "={{ $env.GOOGLE_CLIENT_ID }}" },
            { "name": "client_secret", "value": "={{ $env.GOOGLE_CLIENT_SECRET }}" },
            { "name": "refresh_token", "value": "={{ $json.refresh_token }}" },
            { "name": "grant_type", "value": "refresh_token" }
          ]
        },
        "options": {
          "response": { "response": { "fullResponse": true } },
          "timeout": 10000,
          "batching": { "batch": { "batchSize": 3, "batchInterval": 1000 } }
        }
      },
      "id": "batch-refresh-tokens",
      "name": "Refresh Token (Batch)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 400],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// ==========================================================\n// Process batch refresh results and update sheet\n// ==========================================================\nconst response = $input.first().json;\nconst prevData = $('Filter Expiring Tokens').item.json;\n\nconst body = response.body || response;\n\nif (!body.access_token) {\n  // Refresh failed — mark user for re-auth\n  return [{ json: {\n    chat_id: prevData.chat_id,\n    access_token: '',\n    token_expiry: '',\n    state: 'token_error'\n  } }];\n}\n\nconst expiresIn = body.expires_in || 3600;\nconst tokenExpiry = new Date(Date.now() + (expiresIn * 1000)).toISOString();\n\nreturn [{ json: {\n  chat_id: prevData.chat_id,\n  access_token: body.access_token,\n  token_expiry: tokenExpiry,\n  state: 'active'\n} }];"
      },
      "id": "process-batch-refresh",
      "name": "Process Refresh Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1350, 400]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "mode": "list", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "list", "value": "Users" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "access_token": "={{ $json.access_token }}",
            "token_expiry": "={{ $json.token_expiry }}",
            "state": "={{ $json.state }}"
          }
        },
        "options": { "cellFormat": "USER_ENTERED" },
        "matchingColumns": ["chat_id"],
        "valueToMatchOn": "={{ $json.chat_id }}"
      },
      "id": "save-batch-tokens",
      "name": "Save Refreshed Tokens",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1570, 400]
    }
  ],
  "connections": {
    "Every 45 Minutes": {
      "main": [
        [{ "node": "Read All Users", "type": "main", "index": 0 }]
      ]
    },
    "Read All Users": {
      "main": [
        [{ "node": "Filter Expiring Tokens", "type": "main", "index": 0 }]
      ]
    },
    "Filter Expiring Tokens": {
      "main": [
        [{ "node": "Any to Refresh?", "type": "main", "index": 0 }]
      ]
    },
    "Any to Refresh?": {
      "main": [
        [],
        [{ "node": "Refresh Token (Batch)", "type": "main", "index": 0 }]
      ]
    },
    "Refresh Token (Batch)": {
      "main": [
        [{ "node": "Process Refresh Result", "type": "main", "index": 0 }]
      ]
    },
    "Process Refresh Result": {
      "main": [
        [{ "node": "Save Refreshed Tokens", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [
    { "name": "WhatsApp Calendar Assistant" },
    { "name": "Maintenance" }
  ],
  "triggerCount": 1,
  "versionId": "1"
}
