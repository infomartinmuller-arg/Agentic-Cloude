# =============================================================================
# WhatsApp Calendar Assistant - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# =============================================================================

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=your-instance-name
# WhatsApp number in JID format (e.g., 5493437527193@s.whatsapp.net)
EVOLUTION_WHATSAPP_JID=your-number@s.whatsapp.net

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-your-openai-api-key

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# --- n8n ---
N8N_BASE_URL=https://your-n8n-instance.example.com
# Webhook URLs (auto-generated by n8n based on N8N_BASE_URL)
# Production: ${N8N_BASE_URL}/webhook/Asistente personal
# Test:       ${N8N_BASE_URL}/webhook-test/Asistente personal

# --- Google Sheets (User Data Store) ---
GOOGLE_SHEET_ID=your-google-sheet-id

# --- User Defaults ---
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
